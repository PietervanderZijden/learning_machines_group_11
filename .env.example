# Copy this file to .env on the deployment machine.
# Do not commit .env because it may contain credentials.
#
# The launch scripts also forward ROS variables exported by the host shell.
ROS_MASTER_URI=http://ROBOT_OR_ROS_MASTER_IP:11311
ROS_IP=DEPLOYMENT_MACHINE_REACHABLE_IP
ROS_XMLRPC_PORT=45100
ROS_TCPROS_PORT=45101

# Optional:
# WANDB_API_KEY=
